audit_seal [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#fcebef"><B>audit_seal</B><BR/><FONT POINT-SIZE="12">审计链封存状态</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="last_id" ALIGN="LEFT">last_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="last_hash" ALIGN="LEFT">last_hash</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="last_seq" ALIGN="LEFT">last_seq</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="anchor_seq" ALIGN="LEFT">anchor_seq</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="anchor_hash" ALIGN="LEFT">anchor_hash</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="v2_from_seq" ALIGN="LEFT">v2_from_seq</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">单行状态 id=1；无审计事件外键</FONT></TD></TR></TABLE>>];
