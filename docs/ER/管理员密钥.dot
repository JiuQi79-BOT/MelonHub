digraph MelonHub {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.35", splines=polyline, fontname="Arial", fontsize=18, labelloc=t, labeljust=l, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=12];
edge [dir=none, color="#7b8991", fontcolor="#52616a", fontname="Arial", fontsize=10, labeldistance=1.8, labelangle=25];
label="MelonHub E-R：管理员、会话与软件密钥\nFlyway V7 | 2026-10-28 | PK 主键 · FK 外键 · UK 唯一约束 · ? 可空\n只列关键字段；实线均为真实外键，线两端数字为关联基数";
applications [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>applications</B><BR/><FONT POINT-SIZE="12">业务软件</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="rate_limit" ALIGN="LEFT">rate_limit ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">int</FONT></TD></TR></TABLE>>];
application_keys [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#eaf1fb"><B>application_keys</B><BR/><FONT POINT-SIZE="12">软件 API Key</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="key_hash" ALIGN="LEFT">key_hash</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="expires_at" ALIGN="LEFT">expires_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="revoked_at" ALIGN="LEFT">revoked_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR></TABLE>>];
admin_accounts [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#eaf1fb"><B>admin_accounts</B><BR/><FONT POINT-SIZE="12">控制台管理员</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="username" ALIGN="LEFT">username</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="role" ALIGN="LEFT">role</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(32)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="credential_version" ALIGN="LEFT">credential_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR></TABLE>>];
admin_sessions [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#eaf1fb"><B>admin_sessions</B><BR/><FONT POINT-SIZE="12">管理员会话</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="token_hash" ALIGN="LEFT">token_hash</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="username" ALIGN="LEFT">username</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="expires_at" ALIGN="LEFT">expires_at</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="credential_version" ALIGN="LEFT">credential_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR></TABLE>>];
admin_account_applications [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#eaf1fb"><B>admin_account_applications</B><BR/><FONT POINT-SIZE="12">管理员软件范围</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="username" ALIGN="LEFT">username</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (username, application_id)</FONT></TD></TR></TABLE>>];
admin_accounts -> admin_account_applications [taillabel="1", headlabel="0..N", label="username", tooltip="fk_account_apps_account: ON DELETE CASCADE"];
applications -> admin_account_applications [taillabel="1", headlabel="0..N", label="application_id", tooltip="fk_account_apps_application: ON DELETE CASCADE"];
admin_accounts -> admin_sessions [taillabel="1", headlabel="0..N", label="username", tooltip="fk_admin_sessions_account: ON DELETE CASCADE"];
applications -> application_keys [taillabel="1", headlabel="0..N", label="application_id", tooltip="fk_application_keys_application: ON DELETE CASCADE"];
}
