digraph MelonHub {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.35", splines=polyline, fontname="Arial", fontsize=18, labelloc=t, labeljust=l, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=12];
edge [dir=none, color="#7b8991", fontcolor="#52616a", fontname="Arial", fontsize=10, labeldistance=1.8, labelangle=25];
label="MelonHub E-R：组织、软件授权与上下文\nFlyway V7 | 2026-10-28 | PK 主键 · FK 外键 · UK 唯一约束 · ? 可空\n只列关键字段；实线均为真实外键，线两端数字为关联基数";
departments [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>departments</B><BR/><FONT POINT-SIZE="12">部门</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR></TABLE>>];
memberships [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>memberships</B><BR/><FONT POINT-SIZE="12">部门成员</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (user_id, department_id)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>users</B><BR/><FONT POINT-SIZE="12">业务用户</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="external_id" ALIGN="LEFT">external_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="active_department_id" ALIGN="LEFT">active_department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="context_version" ALIGN="LEFT">context_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">active_department_id 为历史兼容字段</FONT></TD></TR></TABLE>>];
user_roles [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>user_roles</B><BR/><FONT POINT-SIZE="12">用户角色分配</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="expires_at" ALIGN="LEFT">expires_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="granted_by" ALIGN="LEFT">granted_by</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="grant_id" ALIGN="LEFT">grant_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(36)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (user_id, role_id)</FONT></TD></TR></TABLE>>];
roles [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>roles</B><BR/><FONT POINT-SIZE="12">软件角色</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (id, application_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (application_id, code)</FONT></TD></TR></TABLE>>];
applications [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>applications</B><BR/><FONT POINT-SIZE="12">业务软件</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="rate_limit" ALIGN="LEFT">rate_limit ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">int</FONT></TD></TR></TABLE>>];
role_permissions [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>role_permissions</B><BR/><FONT POINT-SIZE="12">角色权限关联</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="permission_id" ALIGN="LEFT">permission_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (role_id, permission_id)</FONT></TD></TR></TABLE>>];
permissions [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>permissions</B><BR/><FONT POINT-SIZE="12">软件共享权限</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="resource" ALIGN="LEFT">resource</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="action" ALIGN="LEFT">action</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (id, application_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (application_id, code)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">当前无 role_id / department_id</FONT></TD></TR></TABLE>>];
permission_contexts [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>permission_contexts</B><BR/><FONT POINT-SIZE="12">权限上下文</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="context_version" ALIGN="LEFT">context_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="expires_at" ALIGN="LEFT">expires_at</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR></TABLE>>];
context_roles [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>context_roles</B><BR/><FONT POINT-SIZE="12">上下文激活角色</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="context_id" ALIGN="LEFT">context_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (context_id, role_id)</FONT></TD></TR></TABLE>>];
permission_contexts -> context_roles [taillabel="1", headlabel="0..N", label="context_id", tooltip="context_roles_ibfk_1: ON DELETE CASCADE"];
