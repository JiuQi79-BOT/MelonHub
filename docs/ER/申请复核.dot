digraph MelonHub {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.35", splines=polyline, fontname="Arial", fontsize=18, labelloc=t, labeljust=l, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=12];
edge [dir=none, color="#7b8991", fontcolor="#52616a", fontname="Arial", fontsize=10, labeldistance=1.8, labelangle=25];
label="MelonHub E-R：角色申请与权限复核\nFlyway V7 | 2026-10-28 | PK 主键 · FK 外键 · UK 唯一约束 · ? 可空\n只列关键字段；实线均为真实外键，线两端数字为关联基数";
applications [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>applications</B><BR/><FONT POINT-SIZE="12">业务软件</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="rate_limit" ALIGN="LEFT">rate_limit ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">int</FONT></TD></TR></TABLE>>];
departments [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>departments</B><BR/><FONT POINT-SIZE="12">部门</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>users</B><BR/><FONT POINT-SIZE="12">业务用户</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="external_id" ALIGN="LEFT">external_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="active_department_id" ALIGN="LEFT">active_department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="context_version" ALIGN="LEFT">context_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">active_department_id 为历史兼容字段</FONT></TD></TR></TABLE>>];
roles [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>roles</B><BR/><FONT POINT-SIZE="12">软件角色</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (id, application_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (application_id, code)</FONT></TD></TR></TABLE>>];
access_requests [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#fff1da"><B>access_requests</B><BR/><FONT POINT-SIZE="12">角色申请</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="duration_days" ALIGN="LEFT">duration_days ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">int</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="status" ALIGN="LEFT">status</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(16)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="grant_expires_at" ALIGN="LEFT">grant_expires_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="user_name" ALIGN="LEFT">user_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="role_name" ALIGN="LEFT">role_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="pending_role_id" ALIGN="LEFT">pending_role_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (user_id, pending_role_id)</FONT></TD></TR></TABLE>>];
access_reviews [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#fff1da"><B>access_reviews</B><BR/><FONT POINT-SIZE="12">权限复核</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="status" ALIGN="LEFT">status</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(16)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="due_at" ALIGN="LEFT">due_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="department_name" ALIGN="LEFT">department_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR></TABLE>>];
access_review_items [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#fff1da"><B>access_review_items</B><BR/><FONT POINT-SIZE="12">复核条目</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="review_id" ALIGN="LEFT">review_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="decision" ALIGN="LEFT">decision</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(16)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="applied" ALIGN="LEFT">applied</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="grant_id" ALIGN="LEFT">grant_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(36)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="skipped" ALIGN="LEFT">skipped</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="user_name" ALIGN="LEFT">user_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="role_name" ALIGN="LEFT">role_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (review_id, user_id, role_id)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">department_id / grant_id 不是外键</FONT></TD></TR></TABLE>>];
