digraph MelonHub {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.35", splines=polyline, fontname="Arial", fontsize=18, labelloc=t, labeljust=l, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=12];
edge [dir=none, color="#7b8991", fontcolor="#52616a", fontname="Arial", fontsize=10, labeldistance=1.8, labelangle=25];
label="MelonHub 数据库 E-R 全图（25 张表 / 30 条外键）\nFlyway V7 | 2026-10-28 | PK 主键 · FK 外键 · UK 唯一约束 · ? 可空\n只列关键字段；实线均为真实外键，线两端数字为关联基数";
subgraph cluster_core { label="01 组织与软件授权"; color="#dce2e5"; fontsize=16;
departments [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>departments</B><BR/><FONT POINT-SIZE="12">部门</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="code" ALIGN="LEFT">code</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(64)</FONT></TD></TR></TABLE>>];
memberships [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>memberships</B><BR/><FONT POINT-SIZE="12">部门成员</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (user_id, department_id)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>users</B><BR/><FONT POINT-SIZE="12">业务用户</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="id" ALIGN="LEFT">id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="name" ALIGN="LEFT">name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">UK</FONT></TD><TD WIDTH="210" PORT="external_id" ALIGN="LEFT">external_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="enabled" ALIGN="LEFT">enabled</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="active_department_id" ALIGN="LEFT">active_department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="context_version" ALIGN="LEFT">context_version</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">active_department_id 为历史兼容字段</FONT></TD></TR></TABLE>>];
user_roles [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#e9f5f0"><B>user_roles</B><BR/><FONT POINT-SIZE="12">用户角色分配</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="user_id" ALIGN="LEFT">user_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK,FK</FONT></TD><TD WIDTH="210" PORT="role_id" ALIGN="LEFT">role_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="department_id" ALIGN="LEFT">department_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">FK</FONT></TD><TD WIDTH="210" PORT="application_id" ALIGN="LEFT">application_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="expires_at" ALIGN="LEFT">expires_at ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">timestamp</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="granted_by" ALIGN="LEFT">granted_by</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="grant_id" ALIGN="LEFT">grant_id</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">char(36)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">PK (user_id, role_id)</FONT></TD></TR></TABLE>>];
