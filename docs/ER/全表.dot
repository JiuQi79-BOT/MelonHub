er_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="role_name" ALIGN="LEFT">role_name</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(100)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="pending_role_id" ALIGN="LEFT">pending_role_id ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">bigint</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#fafbfc"><FONT POINT-SIZE="10" COLOR="#57636b">UK (user_id, pending_role_id)</FONT></TD></TR></TABLE>>];
