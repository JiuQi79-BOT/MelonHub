flyway_schema_history [label=<<TABLE WIDTH="440" BORDER="1" COLOR="#76828a" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#f0f1f2"><B>flyway_schema_history</B><BR/><FONT POINT-SIZE="12">Flyway 迁移记录</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">PK</FONT></TD><TD WIDTH="210" PORT="installed_rank" ALIGN="LEFT">installed_rank</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">int</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="version" ALIGN="LEFT">version ?</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(50)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="description" ALIGN="LEFT">description</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">varchar(200)</FONT></TD></TR><TR><TD WIDTH="48" ALIGN="LEFT"><FONT COLOR="#57636b">&#160;</FONT></TD><TD WIDTH="210" PORT="success" ALIGN="LEFT">success</TD><TD WIDTH="120" ALIGN="LEFT"><FONT COLOR="#57636b">tinyint(1)</FONT></TD></TR></TABLE>>];
