diff --git a/backend/src/main/java/cn/edu/xmu/projectmgt/infrastructure/security/MelonHubAuthorization.java b/backend/src/main/java/cn/edu/xmu/projectmgt/infrastructure/security/MelonHubAuthorization.java
new file mode 100644
index 0000000..2068ea8
--- /dev/null
+++ b/backend/src/main/java/cn/edu/xmu/projectmgt/infrastructure/security/MelonHubAuthorization.java
@@ -0,0 +1,160 @@
+package cn.edu.xmu.projectmgt.infrastructure.security;
+
+import cn.edu.xmu.projectmgt.infrastructure.http.ExternalRestClientFactory;
+import cn.edu.xmu.projectmgt.service.ddd.domain.model.CurrentIdentity;
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.client.HttpClientErrorException;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.client.RestClientException;
+
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static cn.edu.xmu.projectmgt.infrastructure.security.AuthorityCodes.*;
+
+/** Resolves administrative permissions for the authenticated subject on each request. */
+@Component
+@ConditionalOnProperty(name = "app.melonhub.enabled", havingValue = "true")
+public class MelonHubAuthorization {
+    private static final Logger LOG = LoggerFactory.getLogger(MelonHubAuthorization.class);
+    private static final String CONTEXTS = "/api/v1/contexts";
+    private static final int MAX_CONTEXTS = 512;
+    private static final Set<String> COURSE_PERMISSIONS = Set.of(COURSE_VIEW, COURSE_REVIEW, COURSE_RESET,
+            COURSE_EDIT, COURSE_DELETE, COURSE_COPY, COURSE_TEAM_MANAGE);
+    private static final Set<String> TERM_PERMISSIONS = Set.of(TERM_CREATE, TERM_EDIT, TERM_DELETE, TERM_CURRENT_MANAGE);
+    private static final Set<String> TEACHER_PERMISSIONS = Set.of(TEACHER_VIEW, TEACHER_CREATE, TEACHER_EDIT, TEACHER_DELETE);
+    private static final Set<String> MENU_CODES = Set.of("MCO", "MTR", "MTE", "MLG");
+    private static final Map<String, String> BUTTON_CODES = Map.ofEntries(
+            Map.entry(COURSE_REVIEW, "MCOR"), Map.entry(COURSE_EDIT, "MCOE"),
+            Map.entry(COURSE_DELETE, "MCOD"), Map.entry(COURSE_TEAM_MANAGE, "MCOT"),
+            Map.entry(TERM_CREATE, "MTRC"), Map.entry(TERM_EDIT, "MTRE"),
+            Map.entry(TERM_DELETE, "MTRD"), Map.entry(TERM_CURRENT_MANAGE, "MTRM"),
+            Map.entry(TEACHER_CREATE, "MTEC"), Map.entry(TEACHER_EDIT, "MTEE"),
+            Map.entry(TEACHER_DELETE, "MTED"), Map.entry(USER_LOOKUP, "MTEL"));
+
+    private final RestClient client;
+    private final String apiKey;
+    private final long departmentId;
+    // Cache only context tokens. Permissions are always read from /check.
+    private final LinkedHashMap<String, String> contexts = new LinkedHashMap<>(16, 0.75f, true);
+
+    public MelonHubAuthorization(ExternalRestClientFactory clients,
+                                  @Value("${app.melonhub.base-url}") String baseUrl,
+                                  @Value("${app.melonhub.api-key}") String apiKey,
+                                  @Value("${app.melonhub.department-id}") long departmentId) {
+        if (apiKey.isBlank() || departmentId <= 0) {
+            throw new IllegalArgumentException("启用 MelonHub 时需配置 API Key 和业务部门 ID。");
+        }
+        this.client = clients.create(baseUrl);
+        this.apiKey = apiKey;
+        this.departmentId = departmentId;
+    }
+
+    public CurrentIdentity authorize(CurrentIdentity identity) {
+        Set<String> granted = readGrants(identity.userId());
+        var permissions = new LinkedHashSet<String>();
+        if (identity.permissions() != null) {
+            for (String permission : identity.permissions()) {
+                if (permission != null && !ALL_PERMISSIONS.contains(permission)
+                        && !MENU_CODES.contains(permission) && !BUTTON_CODES.containsValue(permission)) {
+                    permissions.add(permission);
+                }
+            }
+        }
+
+        permissions.addAll(granted);
+        granted.forEach(permission -> {
+            String button = BUTTON_CODES.get(permission);
+            if (button != null) permissions.add(button);
+        });
+        if (granted.stream().anyMatch(COURSE_PERMISSIONS::contains)) {
+            permissions.add(COURSE_VIEW);
+            permissions.add("MCO");
+        }
+        if (granted.stream().anyMatch(TERM_PERMISSIONS::contains)) permissions.add("MTR");
+        if (granted.stream().anyMatch(TEACHER_PERMISSIONS::contains)) {
+            permissions.add(TEACHER_VIEW);
+            permissions.add("MTE");
+        }
+        if (granted.contains(AUDIT_VIEW)) permissions.add("MLG");
+        return new CurrentIdentity(identity.userId(), identity.roles(), List.copyOf(permissions));
+    }
+
+    private Set<String> readGrants(String externalId) {
+        try {
+            String token = context(externalId);
+            try {
+                return check(token);
+            } catch (HttpClientErrorException.Unauthorized expired) {
+                synchronized (contexts) {
+                    contexts.remove(externalId, token);
+                }
+                return check(context(externalId));
+            }
+        } catch (HttpClientErrorException failure) {
+            int status = failure.getStatusCode().value();
+            // Unknown users, non-members and users active in another department have no grants in this domain.
+            if (status != 403 && status != 404 && status != 409) {
+                LOG.warn("MelonHub 权限校验失败，HTTP {}", status);
+            }
+            return Set.of();
+        } catch (RestClientException failure) {
+            LOG.warn("MelonHub 权限校验失败，{}", failure.getClass().getSimpleName());
+            return Set.of();
+        }
+    }
+
+    private String context(String externalId) {
+        synchronized (contexts) {
+            String token = contexts.get(externalId);
+            if (token != null) return token;
+        }
+
+        ContextReply reply = client.post().uri(CONTEXTS)
+                .header("X-API-Key", apiKey)
+                .contentType(MediaType.APPLICATION_JSON)
+                .body(new ContextRequest(externalId, departmentId, false))
+                .retrieve().body(ContextReply.class);
+        if (reply == null || reply.contextToken() == null || reply.contextToken().isBlank()) {
+            throw new RestClientException("MelonHub 未返回有效上下文。");
+        }
+        synchronized (contexts) {
+            String token = contexts.computeIfAbsent(externalId, ignored -> reply.contextToken());
+            if (contexts.size() > MAX_CONTEXTS) contexts.pollFirstEntry();
+            return token;
+        }
+    }
+
+    private Set<String> check(String token) {
+        CheckReply reply = client.post().uri(CONTEXTS + "/check")
+                .header("X-API-Key", apiKey)
+                .header("X-Context-Token", token)
+                .contentType(MediaType.APPLICATION_JSON)
+                .body(new CheckRequest(ALL_PERMISSIONS))
+                .retrieve().body(CheckReply.class);
+        if (reply == null || reply.decisions() == null) {
+            throw new RestClientException("MelonHub 未返回权限校验结果。");
+        }
+        var granted = new LinkedHashSet<String>();
+        for (String permission : ALL_PERMISSIONS) {
+            if (Boolean.TRUE.equals(reply.decisions().get(permission))) granted.add(permission);
+        }
+        return granted;
+    }
+
+    private record ContextRequest(String externalId, long departmentId, boolean switchDepartment) {}
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    private record ContextReply(String contextToken) {}
+    private record CheckRequest(Set<String> permissions) {}
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    private record CheckReply(Map<String, Boolean> decisions) {}
+}
