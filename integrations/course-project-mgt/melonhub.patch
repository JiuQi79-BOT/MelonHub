new file mode 100644
index 0000000..53621b5
--- /dev/null
+++ b/web/src/composables/current-permissions.ts
@@ -0,0 +1,43 @@
+import { computed, onMounted, onUnmounted, shallowRef, watch } from 'vue'
+import { useRoute } from 'vue-router'
+import { currentUserApi } from '@/api/current-user'
+import type { CurrentUser } from '@/types/current-user'
+
+export function useCurrentPermissions() {
+  const route = useRoute()
+  const user = shallowRef<CurrentUser | null>(null)
+  const permissionsLoaded = shallowRef(false)
+  const permissions = computed(() => new Set(user.value?.permissions ?? []))
+  let refreshing = false
+  let timer: number | undefined
+
+  async function refreshPermissions() {
+    if (refreshing) return
+    refreshing = true
+    try {
+      user.value = await currentUserApi.getCurrentUser()
+    } catch {
+      user.value = null
+    } finally {
+      permissionsLoaded.value = true
+      refreshing = false
+    }
+  }
+
+  onMounted(() => {
+    void refreshPermissions()
+    window.addEventListener('focus', refreshPermissions)
+    timer = window.setInterval(() => {
+      if (!document.hidden) void refreshPermissions()
+    }, 5000)
+  })
+
+  watch(() => route.fullPath, () => { void refreshPermissions() })
+
+  onUnmounted(() => {
+    window.removeEventListener('focus', refreshPermissions)
+    window.clearInterval(timer)
+  })
+
+  return { user, permissions, permissionsLoaded, refreshPermissions }
+}
