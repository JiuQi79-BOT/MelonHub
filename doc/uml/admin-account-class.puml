@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
title 创建管理员 · structured 类图（相关成员）
left to right direction
interface "AuthUseCase" as U <<interface>> {
 + createAccount(input, actor): long
}
class "StructuredAuthService" as S {
 - accounts: AdminAccountRepository
 - roles: AdminRoleRepository
 - audit: AuditUseCase
 --
 + createAccount(input, actor): long
 - {static} requireConsistent(nodes, roleFunctions): void
 - {static} with(nodes, changed): List
}
interface "AdminAccountRepository" as Repo <<interface>> {
 + lockAll(): List<AdminAccount>
 + nodes(): List<Node>
 + createAccount(...): long
 + replaceApplicationIds(id, applications): void
 + replaceDepartmentIds(id, departments): void
}
interface "AdminRoleRepository" as Roles <<interface>> {
 + listed(): List<AdminRole>
}
class "StructuredAdminHierarchyProcedures" as Rules <<utility>> {
 --
 + {static} findNode(accounts, id): AccountNode
 + {static} manages(accounts, actor, target): boolean
 + {static} replaceNode(accounts, changed): List
 + {static} findViolations(accounts, roleFunctions): List
}
interface "AuditUseCase" as Audit <<interface>> {
 + audit(actor, action, target, dept, app, detail): void
}
S .up.|> U
S -right-> Repo : accounts
S -left-> Roles : roles
S .down.> Rules
S -down-> Audit : audit
note bottom of Rules
规则接收记录集合；过程本身不持有领域状态。
AccountController 通过 AuthUseCase 调用 createAccount。
end note
@enduml
