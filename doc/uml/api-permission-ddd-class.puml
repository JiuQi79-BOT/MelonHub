title API 权限查询 · ddd 类图（相关成员）
left to right direction
interface "IdentityUseCase" as U <<interface>> {
 + checkApiPermission(authorization, operationId): Map
}
class "DddIdentityService" as S {
 - repository: IdentityRepositoryPort
 - tokens: IdentityTokenGateway
 --
 + checkApiPermission(authorization, operationId): Map
 - authenticatedUser(authorization): IdentityUser
}
interface "IdentityRepositoryPort" as R <<interface>> {
 + hasActiveSession(hash, now): boolean
 + findUserByExternalId(externalId): Optional
 + permissions(userId, system): List
}
class "JpaIdentityRepositoryAdapter" as A {
 - dao: IdentityDao
 --
 + permissions(userId, system): List
}
class "IdentityDao" as DAO {
 --
 + permissions(userId, system): List
}
class "CoursePermissionCatalog" as Catalog <<utility>> {
 --
 + {static} requirePermissionForOperation(operationId): String
}
class "IdentityAccountAggregate" as Model <<domain model>> {
 - user: IdentityUser
 - permissions: List
 --
 + hasUiPermission(permission): boolean
}
S .up.|> U
S -right-> R : repository
A .up.|> R
A -right-> DAO : dao
Catalog .[hidden]right. Model
S .down.> Catalog
S .down.> Model
note left of S
Controller 依赖 IdentityUseCase；
令牌、加密与异常边界见时序图。
