@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
title API 权限查询 · structured 类图（相关成员）
left to right direction
class "IdentityController" as C {
 - identityService: IdentityUseCase
 --
 + apiPermission(authorization, operationId): IdentityApiPermissionCheckVO
}
interface "IdentityUseCase" as U <<interface>> {
 + checkApiPermission(authorization, operationId): IdentityApiPermissionCheckResult
}
class "StructuredIdentityService" as S {
 - sessions: IdentitySessionRepository
 - users: UserRepository
 - userRoles: UserRoleRepository
 - roleInheritances: RoleInheritanceRepository
 - rolePermissions: RolePermissionRepository
 - tokenService: IdentityTokenService
 - {static} API_PERMISSION_CODES: Map
 --
 + checkApiPermission(authorization, operationId): IdentityApiPermissionCheckResult
 - authenticatedUser(authorization): IdentityUser
 - effectivePermissionCodes(userId, system): List
}
interface "IdentitySessionRepository" as SR <<interface>> {
 + hasActiveSession(hash, now): boolean
}
interface "UserRepository" as UR <<interface>> {
 + findActiveIdentityUserByExternalId(externalId): Optional
}
interface "RolePermissionRepository" as PR <<interface>> {
 + findActivePermissionCodesByRoleIds(roleIds): List
}
class "IdentityTokenService" as T {
 --
 + verify(token, audience): Claims
}
C -right-> U : identityService
S .up.|> U
C -[hidden]right- S
S -right-> SR : sessions
S -right-> UR : users
S -right-> PR : rolePermissions
S -down-> T : tokenService
legend bottom
过程内部完成认证、操作映射、RBAC1 角色继承展开与权限包含判断。
事务由 checkApiPermission 的只读事务边界管理。
endlegend
@enduml
