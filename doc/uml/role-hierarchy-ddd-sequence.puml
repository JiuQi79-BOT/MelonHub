@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
hide footbox
title RBAC1 设置角色继承 · ddd
participant "obj: AdminController" as C
participant "service: DddRbacService" as S
participant "repository: RbacRepositoryPort" as P
participant "cache: CacheGateway" as Cache
participant "events: WebhookGateway" as W
autonumber
activate C
C -> S: roleParents(role, dept, app, parentIds, actor)
activate S
S -> P: scoped(role, dept, app)
activate P
deactivate P
S -> P: scopedCount(parentIds, dept, app)
activate P
deactivate P
loop each parent role
 S -> P: inheritedRoleIds(parent, dept, app)
 activate P
 deactivate P
end
alt 自身、跨域或循环继承
 P --> S: DomainException
 S --> C: ApiException (403/409)
else 合法
 S -> P: lockRole(role)
 activate P
 deactivate P
 S -> P: replaceRoleParents(role, dept, app, parentIds)
 activate P
 deactivate P
 S -> Cache: touchDomain(dept, app)
 activate Cache
 deactivate Cache
 S -> W: emit(role.inheritance.changed)
 activate W
 deactivate W
 S --> C: 200 {}
end
deactivate S
deactivate C
legend bottom
DddRbacService 负责应用编排，端口适配器委托 RbacDao。
权限闭包在 ContextDao/适配器读取路径中展开。
endlegend
@enduml
