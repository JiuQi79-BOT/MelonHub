@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
hide footbox
title RBAC1 角色继承 · ddd 类图（相关成员）
left to right direction
class "DomainRbacAdminController" as C {
 + roleParents(id, departmentId, applicationId, body, request): OkVO
}
interface "DomainRbacUseCase" as U <<interface>> {
 + roleParents(role, department, application, parents, actor): void
}
class "DddDomainRbacService" as S {
 - repository: RbacRepositoryPort
 - cache: CacheGateway
 - events: DomainEventPublisher
 - transactions: TransactionRunner
 --
 + roleParents(role, dept, app, parents, actor): void
 + roles(dept, app): List
}
interface "RbacRepositoryPort" as P <<interface>> {
 + domainRoleIds(dept, app): List<Long>
 + lockDomainRolesByIds(dept, app, roleIds): Set<Long>
 + domainRoleInheritanceEdges(dept, app): List
 + replaceRoleParents(child, dept, app, existing, parents): void
}
class "JpaRbacRepositoryAdapter" as A {
 - roles: RoleRepository
 - roleInheritances: RoleInheritanceRepository
 --
 + domainRoleIds(dept, app): List<Long>
 + lockDomainRolesByIds(dept, app, roleIds): Set<Long>
 + domainRoleInheritanceEdges(dept, app): List
 + replaceRoleParents(child, dept, app, existing, parents): void
}
interface "RoleInheritanceRepository" as RIR <<interface>> {
 + findEdgesByDomain(dept, app): List
 + replaceParents(child, dept, app, existing, parents): void
}
class "RoleInheritance" as RI {
 - id: RoleInheritanceId
 - childRole: Role
 - parentRole: Role
 - departmentId: Long
 - applicationId: Long
}
C -right-> U : use case
S .up.|> U
S -right-> P : repository
A .up.|> P
A -right-> RIR : roleInheritances
RIR .down.> RI : persistence model
note left of S
DDD 应用服务经 TransactionRunner 编排：
事务外查本域角色 ID，事务内首条 SQL 主键升序加锁，
随后无锁读边判环并按精确主键差集更新，无 DAO 层。
end note
@enduml
