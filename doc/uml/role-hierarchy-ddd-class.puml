@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
hide footbox
title RBAC1 角色继承 · ddd 类图（相关成员）
left to right direction
class "AdminController" as C {
 + roleParents(id, departmentId, applicationId, ids, request): Object
}
interface "RbacUseCase" as U <<interface>> {
 + roleParents(role, department, application, parents, actor): void
}
class "DddRbacService" as S {
 - repository: RbacRepositoryPort
 - cache: CacheGateway
 - events: WebhookGateway
 --
 + roleParents(role, dept, app, parents, actor): void
 + roles(dept, app): List
}
interface "RbacRepositoryPort" as P <<interface>> {
 + inheritedRoleIds(roots, dept, app): List
 + replaceRoleParents(child, dept, app, parents): void
 + domainRoleInheritancePairs(dept, app): List
}
class "JpaRbacRepositoryAdapter" as A {
 - dao: RbacDao
 + inheritedRoleIds(roots, dept, app): List
 + replaceRoleParents(child, dept, app, parents): void
}
class "RbacDao" as D {
 + roleInheritancePairs(dept, app): List
 + inheritedRoleIds(roots, dept, app): List
 + replaceRoleParents(child, dept, app, parents): void
}
class "RoleInheritance" as RI {
 - childRoleId: Long
 - parentRoleId: Long
 - departmentId: Long
 - applicationId: Long
}
C -right-> U : use case
S .up.|> U
S -right-> P : repository
A .up.|> P
A -right-> D : dao
D .down.> RI : persistence model
note left of S
DDD 应用服务协调事务、校验、端口、
缓存失效、事件和审计。
当前层级闭包读取由仓储端口委托 DAO。
end note
@enduml
