@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
title 创建管理员 · ddd 类图（相关成员）
left to right direction
interface "AuthUseCase" as U <<interface>> {
 + createAccount(input, actor): long
}
class "DddAuthService" as S {
 - accounts: AdminAccountRepositoryPort
 - roles: AdminRoleRepositoryPort
 - crypto: CryptoGateway
 - audit: AuditUseCase
 --
 + createAccount(input, actor): long
 - hierarchy(): AdminHierarchy
}
interface "AdminAccountRepositoryPort" as R <<interface>> {
 + lockAllAccounts(): void
 + loadHierarchyNodes(): List<AdminNode>
 + createAccount(...): long
}
class "JpaAdminAccountRepositoryAdapter" as A {
 - accounts: AdminAccountRepository
 - adminRoles: AdminRoleRepository
 - sessions: AdminSessionRepository
 --
 + loadHierarchyNodes(): List<AdminNode>
}
interface "AdminAccountRepository" as Repo <<interface>> {
 + lockAll(): List<AdminAccount>
 + nodes(): List<Node>
 + createAccount(...): long
}
class "AdminHierarchy" as Tree <<domain model>> {
 - nodes: Map<Long, AdminNode>
 - roleFunctions: Map
 --
 + validateCreate(actorId, candidate): AdminNode
 + violations(): List<String>
}
class "AdminScope" as Scope <<value object>> {
 - allDepartments: boolean
 - departments: Set<Long>
 - allApplications: boolean
 - applications: Set<Long>
 --
 + coversDepartmentsOf(child): boolean
 + coversApplicationsOf(child): boolean
}
S .up.|> U
S -right-> R : accounts
A .up.|> R
A -right-> Repo : accounts
S .down.> Tree
S .down.> Scope
Tree .right.> Scope
note left of S
应用服务负责事务、锁与持久化编排；
候选层级不变量由 AdminHierarchy 判断。
适配器直接组合 Spring Data JPA 仓储，无 DAO 中间层。
end note
@enduml
