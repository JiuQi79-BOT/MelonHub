@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
hide footbox
title RBAC1 角色继承 · structured 类图（相关成员）
left to right direction
class "DomainRbacAdminController" as C {
 + roleParents(id, departmentId, applicationId, body, request): OkVO
}
interface "DomainRbacUseCase" as U <<interface>> {
 + roleParents(role, department, application, parents, actor): void
}
class "StructuredDomainRbacService" as S {
 - roles: RoleRepository
 - roleInheritances: RoleInheritanceRepository
 - cache: PermissionCache
 - webhooks: WebhookUseCase
 --
 + roleParents(role, dept, app, parents, actor): void
 + roles(dept, app): List
}
interface "RoleRepository" as RR <<interface>> {
 + findIdsByDomain(dept, app): List<Long>
 + lockDomainRolesByIds(dept, app, roleIds): Set<Long>
}
interface "RoleInheritanceRepository" as RIR <<interface>> {
 + findEdgesByDomain(dept, app): List
 + {static} expandEdges(roots, edges): List
 + mapExpandedToDirectActiveRoles(directRoles, dept, app): Map
 + replaceParents(child, dept, app, existing, parents): void
}
class "RoleInheritance" as RI {
 - id: RoleInheritanceId
 - childRole: Role
 - parentRole: Role
 - departmentId: Long
 - applicationId: Long
}
class "PermissionCache" as Cache <<infrastructure>> {
 + touchDomain(dept, app): void
}
C -right-> U : use case
S .up.|> U
S -right-> RR : roles
S -right-> RIR : roleInheritances
S -down-> Cache : cache
RIR .down.> RI : persistence model
note bottom of S
同域中 child 继承 parent 的权限。
写事务外查本域角色 ID，事务内首条 SQL 仅按主键升序锁 roles，
随后无锁读边判环并按精确联合主键差集更新父角色集合。
end note
@enduml
