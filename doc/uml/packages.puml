@startuml
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #41546B
skinparam classBackgroundColor #F5F8FC
skinparam classBorderColor #59708C
skinparam sequenceParticipantBackgroundColor #EEF3F9
skinparam sequenceParticipantBorderColor #59708C
skinparam sequenceGroupBackgroundColor transparent
skinparam sequenceMessageAlign left
title MelonHub 包依赖 · 启动时选择 structured 或 ddd
top to bottom direction
package "controller / security / config" as Entry {}
package "service.port" as Port {}
package "service.structured" as S {}
package "service.ddd.application" as A {}
package "service.ddd.domain" as D {
 package "model" as Model {}
 package "value" as Value {}
 package "repository（领域端口）" as DomainPort {}
}
package "service.ddd.infrastructure" as I {}
package "dao / cache / identity" as Shared {}
package "entity / repository（Spring Data）" as JPA {}
package "dto / exception" as Boundary {}
Entry ..> Port
Entry ..> Boundary
S ..> Port
A ..> Port
S ..> Shared
A ..> D
A ..> Boundary
I ..> D
I ..> Shared
Shared ..> JPA
Model ..> Value
note bottom of Port
AuthUseCase、IdentityUseCase 等 10 个用例接口。
实现关系在类图中展开；包之间画编译期依赖。
end note
note bottom of D
领域规则与端口不依赖 Spring/JPA。
model 内包含规则模型、快照和报告，
不能仅凭包名将全部类型认定为聚合根。
end note
@enduml
