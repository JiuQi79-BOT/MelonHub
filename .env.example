ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
SEED_DEMO=false
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=cloud

# local: 本机 Java 后端；server: 本机前端通过 SSH 连接已部署后端。
BACKEND_MODE=local
BACKEND_REMOTE_PORT=18080
# 不填写 BACKEND_SSH_* 时沿用下方 SWARM_WORKER_HOST / SWARM_SSH_*。
# BACKEND_SSH_HOST=your_backend_server
# BACKEND_SSH_PORT=22
# BACKEND_SSH_USERNAME=your_ssh_user
# BACKEND_SSH_PASSWORD=your_ssh_password
# BACKEND_IMAGE=eclipse-temurin:21-jre

CLOUD_DB_HOST=your_cloud_mysql_host
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=melonhub_rbac
CLOUD_DB_USERNAME=root
CLOUD_DB_PASSWORD=
SWARM_MANAGER_HOST=
SWARM_WORKER_HOST=
SWARM_SSH_PORT=22
SWARM_SSH_USERNAME=root
SWARM_SSH_PASSWORD=
SWARM_CONFIG_PATH=3.SpringDataJPA/productdemojpa/conf.d/productdemojpa.yml

# 测试必须连接同一云端入口的独立 melonhub_rbac_test 库。
# TEST_DB_URL=jdbc:mysql://your_cloud_mysql_host:3306/melonhub_rbac_test?sslMode=REQUIRED
# TEST_DB_USERNAME=your_test_user
# TEST_DB_PASSWORD=your_test_password

# 服务器 Redis 部署完成后配置并启用；启动器不管理任何数据库或缓存容器。
CACHE_ENABLED=false
# REDIS_HOST=your_server_redis_host
# REDIS_PORT=6379
# REDIS_PASSWORD=replace_with_server_redis_password
# REDIS_DATABASE=0

# 可选调优：去掉行首 # 并修改数值。不要保留空值（KEY=），Spring 会把空字符串当作配置值。
# 每个软件 API Key 每秒请求上限，默认 1000。
# APP_RATE_LIMIT=1000
# 数据库连接池大小，默认 20。
# DB_POOL_SIZE=20
# 审计日志保留天数，默认 180。
# AUDIT_RETENTION_DAYS=180
# 管理员会话空闲超时（分钟），默认 30。
# ADMIN_IDLE_MINUTES=30
# 监控端口（health/metrics/prometheus，仅 127.0.0.1），默认 8081。
# MANAGEMENT_PORT=8081
# 设为 true 时，下次启动用 ADMIN_PASSWORD 重置初始管理员密码并解锁；用完改回 false。
ADMIN_PASSWORD_RESET=false
# 跨实例全局限流（Redis 固定窗口），默认 true；Redis 不可用时自动回退实例内限流。
# GLOBAL_RATE_LIMIT=true
# Webhook 异步投递，默认 true。
# WEBHOOK_DELIVERY_ENABLED=true
# Webhook 投递记录保留天数，默认 30。
# WEBHOOK_RETENTION_DAYS=30
