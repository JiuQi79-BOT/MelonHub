ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
SEED_DEMO=false
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=cloud

# 本机 Docker：将 SPRING_PROFILES_ACTIVE 改为 local，并填写已有 MySQL 的凭据。
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=melonhub_rbac
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=
# 可选：一键启动时拉起此已存在的容器，停止脚本不停止共享数据库。
LOCAL_DB_CONTAINER=

CLOUD_DB_HOST=your_cloud_mysql_host
CLOUD_DB_PORT=3306
CLOUD_DB_NAME=melonhub_rbac
CLOUD_DB_USERNAME=root
CLOUD_DB_PASSWORD=
SWARM_MANAGER_HOST=
SWARM_WORKER_HOST=
SWARM_SSH_PORT=22
SWARM_SSH_USERNAME=root
SWARM_SSH_PASSWORD=
SWARM_CONFIG_PATH=3.SpringDataJPA/productdemojpa/conf.d/productdemojpa.yml

TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
# 测试目标显式选择 cloud 或 local；URL 必须指向 melonhub_rbac_test 并启用 TLS。
TEST_DB_TARGET=cloud

# 权限缓存（Redis）。只作为缓存，MySQL 是唯一数据源；Redis 不可用时自动回退数据库实时校验。
# 一键启动会创建并拉起带 com.melonhub.role=cache 标签的专用容器，只监听 127.0.0.1。
CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# 必填：自行生成至少 32 位的随机字符串；留空时一键启动会提示补全，不会创建无密码 Redis。
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONTAINER=melonhub-redis

# 可选调优：去掉行首 # 并修改数值。不要保留空值（KEY=），Spring 会把空字符串当作配置值。
# 每个软件 API Key 每秒请求上限，默认 1000。
# APP_RATE_LIMIT=1000
# 数据库连接池大小，默认 20。
# DB_POOL_SIZE=20
# 审计日志保留天数，默认 180。
# AUDIT_RETENTION_DAYS=180
# 管理员会话空闲超时（分钟），默认 30。
# ADMIN_IDLE_MINUTES=30
# 监控端口（health/metrics/prometheus，仅 127.0.0.1），默认 8081。
# MANAGEMENT_PORT=8081
# 设为 true 时，下次启动用 ADMIN_PASSWORD 重置初始管理员密码并解锁；用完改回 false。
ADMIN_PASSWORD_RESET=false
# 跨实例全局限流（Redis 固定窗口），默认 true；Redis 不可用时自动回退实例内限流。
# GLOBAL_RATE_LIMIT=true
# Webhook 异步投递，默认 true。
# WEBHOOK_DELIVERY_ENABLED=true
# Webhook 投递记录保留天数，默认 30。
# WEBHOOK_RETENTION_DAYS=30
